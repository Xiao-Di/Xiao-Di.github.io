@articleInfo{Wang2026InnovationInformatics,
title = {From reactive relays to proactive agents: Toward autonomous satellite networks},
journal = {The Innovation Informatics},
pages = {100072},
year = {2026},
issn = {3105-8515},
doi = {10.59717/j.xinn-inform.2026.100072},
url = {https://www.the-innovation.org/informatics/article/id/6ae86667b8f80839c87ca0e0},
author = {Ziteng Wang and Yunxin Geng and Ao Liu and Zexuan Wu and Ziyan Ren and Baichuan Li and Weiwei Jiang},
keywords = {Agentic AI, Autonomous Cognition, Autonomous Satellite Networks, Distributed Orchestration, Trustworthy Agentic AI},
abstract = {As 6G moves toward connected intelligence, satellites are expected to handle increasingly complex tasks onboard. Yet they operate with limited onboard resources in dynamic environments where continuous real-time ground control is difficult. Therefore, conventional intelligent strategies based on predefined decisions have limited adaptability and cannot fully exploit onboard resources. Agentic artificial intelligence (AI) offers a new direction as a task-oriented autonomous decision-making paradigm: it analyzes each task under current operating conditions and resource limits, then plans and executes accordingly, while using execution outcomes as closed-loop feedback. As shown in Figure 1, this Commentary centers on the autonomous cognition that Agentic AI brings to satellites, examines how this capability operates in satellite networks and the security issues it raises, and finally outlines the future development of agentic satellite networks.},
preview = {innovation-informatics.jpg},
description = {This Commentary explores the potential of Agentic AI in enabling autonomous cognition for satellites, highlighting its implications for satellite networks and security considerations.},
}

@misc{geng2026generalizedleochannelprediction,
      title={Toward Generalized LEO Channel Prediction: A Rapid Adaptation Time-Frequency Mamba Framework}, 
      author={Yunxin Geng and Yun Zhao and Weiwei Jiang and Shengfeng Wang and Haotian Liu and Zhiqing Wei},
      year={2026},
      eprint={2611.04224},
      archivePrefix={arXiv},
      primaryClass={eess.SP},
      url={https://arxiv.org/abs/2611.04224},
      preview = {Evo-TFMamba.jpg},
      abstract={Accurate channel state information (CSI) prediction is pivotal for enhancing system capacity in low Earth orbit (LEO) satellite-terrestrial communications within the sixth-generation (6G) vision of global ubiquitous connectivity. However, the extreme mobility of LEO satellites, coupled with significant propagation delays, induces severe channel aging. Existing deep learning (DL) methods often struggle with non-stationary dynamics or generalize poorly across diverse global geographies. To address these challenges, we design the Evo-TFMamba, which is an evolutionary framework integrating time-frequency selective Mamba blocks with meta-learning for generalized CSI prediction. Experimental results demonstrate that the proposed Evo-TFMamba performs adaptive prediction according to the geographic coverage of LEO satellites. Meanwhile, it significantly enhances the model’s generalization ability, particularly when faced with unseen channel environments in LEO satellite communication.},
      description={This study proposes Evo-TFMamba, an evolutionary framework integrating time-frequency selective Mamba blocks with meta-learning for generalized CSI prediction in LEO satellite-terrestrial communications, enhancing adaptive prediction and model generalization across diverse global geographies.},
}

@misc{geng2026hierarchicalspacegroundcollaborativenetwork,
      title={A Hierarchical Space-Ground Collaborative Network: Architecture Design and Deployment}, 
      author={Yunxin Geng and Shaopeng Feng and Xuekun Hao and Zijian Guo and Shengfeng Wang and Rui Ding and Kan Zheng and Zhiqing Wei and Weiwei Jiang and Zhiyong Feng},
      year={2026},
      eprint={2610.28459},
      archivePrefix={arXiv},
      primaryClass={eess.SP},
      url={https://arxiv.org/abs/2610.28459},
      preview = {SGCN-Network.jpg},
      abstract={The sixth-generation (6G) landscape demands a profound architectural evolution toward a unified, collaborative ecosystem that integrates satellite and terrestrial segments to provide ubiquitous global connectivity. Nevertheless, conventional independent management paradigms are increasingly challenged by the profound spatiotemporal nonstationarity of low-Earth orbit (LEO) channels and the volatile demands of massive heterogeneous services. To address these challenges, this study focuses on the architectural design of space-ground integrated networks (SGINs) and investigates elastic deployment strategies tailored to heterogeneous 6G service requirements. We first review the development trends in SGIN and then summarize typical application scenarios into two categories, along with their associated challenges and constraints. After that, a hierarchical space-ground collaborative network (SGCN) architecture is proposed to support achieving larger network capability, extensive continuous coverage, and enhanced spectral efficiency, which is evaluated through three representative scenarios with progressive baselines. Subsequently, a service-aware deployment strategy is introduced to further establish the engineering feasibility of the proposed architecture.},
      description={This study proposes a hierarchical space-ground collaborative network (SGCN) architecture and service-aware deployment strategy to address the challenges of low-Earth orbit (LEO) channels and heterogeneous service demands in sixth-generation (6G) networks, enhancing global connectivity and spectral efficiency.},
}

@misc{geng2026orcaonboardreflectivecollaborative,
      title={ORCA: Onboard Reflective Collaborative Agents for Reliable Task Offloading in LEO Satellite Networks}, 
      author={Yunxin Geng and Shengxiang Hao and Yichen Wu and Haotian Liu and Weiwei Jiang and Lu Cao and Han Meng and Yuxuan Pan and Zhiqing Wei},
      year={2026},
      eprint={2610.28404},
      archivePrefix={arXiv},
      primaryClass={eess.SP},
      url={https://arxiv.org/abs/2610.28404},
      preview={ORCA-GC.jpg},
      abstract={Low Earth orbit (LEO) satellites increasingly perform time-critical onboard processing, yet heterogeneous computing capabilities, rapidly changing inter-satellite links (ISLs) and uncertain neighbor behavior make decentralized task offloading difficult under partial observations. This paper presents ORCA, an architecture of Onboard Reflective Collaborative Agents that organizes offloading as a four-Agent Perceive->Reason->Act->Learn loop to enable autonomous, efficient and reliable onboard task offloading in dynamic, heterogeneous and unreliable LEO satellite networks. The simulation results of a heterogeneous 60-satellite Walker-delta constellation demonstrates that ORCA delivers competitive system efficiency in cooperative settings while achieving superior task-success robustness and offloading reliability under previously unseen malicious node behavior, indicating that outcome-grounded reflection can improve the reliability of decentralized onboard offloading without centralized runtime coordination.},
      description={This paper presents ORCA, an architecture of Onboard Reflective Collaborative Agents that enables autonomous, efficient and reliable onboard task offloading in dynamic, heterogeneous and unreliable LEO satellite networks, enhancing system efficiency and robustness against malicious node behavior.},
}

@article{wei2026isac,
  title={ISAC-empowered LEO constellation networked sensing: Challenges and opportunities},
  author={Wei, Zhiqing and Liu, Haotian and Geng, Yunxin and Feng, Zhiyong and Gui, Guan and Zheng, Kan},
  journal={IEEE Wireless Communications},
  year={2026},
  publisher={IEEE},
  doi={10.1109/MWC.2026.3654488},
  abstract={The pursuit of seamless global coverage in sixth-generation (6G) mobile networks has driven the development of low earth orbit (LEO) constellation networks. In addition to communication, the emerging 6G applications, such as low-altitude economy and smart city, also require high-accuracy, large-scale, and continuous sensing. Integrated sensing and communication (ISAC) has emerged as a key enabler, which could empower LEO constellations with dual capabilities of communication and sensing. With the implementation of networked sensing in ISAC-empowered LEO constellations, the requirements of emerging 6G applications can be satisfied. This article presents a comprehensive overview of networked sensing in ISAC-empowered LEO constellations. We first introduce the concepts, sensing types, application scenarios, and payload enhancements. Then, we delve into critical technical challenges of networked sensing in ISAC-empowered LEO constellations and discuss the promising solutions tailored to the unique characteristics of LEO constellations, such as high mobility and long distances to the targets. Finally, we highlight future research trends to further promote the performance of ISAC-empowered LEO constellations.},
  selected = {true},
  preview = {ISAC-WCM.jpg},
  description={A comprehensive overview of networked sensing in ISAC-empowered LEO constellations, discussing challenges, solutions, and future research trends for 6G applications.},
}

@inproceedings{xu2021weighted,
  title={Weighted RAFT: An improved blockchain consensus mechanism for Internet of Things application},
  author={Xu, Xiaojun and Hou, Lu and Li, Yankai and Geng, Yunxin},
  booktitle={2021 7th International Conference on Computer and Communications (ICCC)},
  pages={1520--1525},
  year={2021},
  organization={IEEE},
  preview = {blockchain-iccc.jpg},
  doi={10.1109/ICCC54389.2021.9674683},
  abstract={The integration of blockchain technology and RAFT consensus algorithm could address many of the IoT application security and privacy issues. However, each node in RAFT consensus has equivalent probability of being elected as a leader, which takes no consideration on the communication and computing status of the node. Therefore, in this paper, we propose a weighted RAFT consensus algorithm for IoT applications, which allows IoT gateway with better capacity to have a higher possibility of being elected as the leader compared to the normal RAFT mechanism. Thus, the latency of uploading IoT data on blockchain can be reduced a lot. Simulation results show that the weighted RAFT can reduce the system forwarding latency by 24% at most.},
  description={An improved blockchain consensus mechanism for Internet of Things applications, enhancing security and efficiency in data management.},
}

@article{hou2024masked,
  title={Masked token enabled pre-training: A task-agnostic approach for understanding complex traffic flow},
  author={Hou, Lu and Geng, Yunxin and Han, Lingyi and Yang, Haojun and Zheng, Kan and Wang, Xianbin},
  journal={IEEE Transactions on Mobile Computing},
  volume={23},
  number={12},
  pages={11121--11132},
  year={2024},
  publisher={IEEE},
  doi={10.1109/TMC.2024.3390941},
  abstract={Accurate analysis of traffic flow (TF) data is crucial for the vehicular applications. Conventional deep learning models require task-specific training and are susceptible to high-frequency disturbances, degrading the feature representation capability. To overcome these limitations, this paper proposes a Token-based Self-Supervised Network (TSSN) that can learn TF features in both tokenization and task-agnostic manners. It provides a properly bootstrapped pre-training model for various downstream tasks. In support of the edge computing and vehicular cloud computing, the pooled computational resources facilitate real-time inferences of downstream models. In TSSN, TF data are segmented into tokens. A pretext task, named as Masked Token Prediction (MTP), is then developed to allow TSSN to understand the underlying correlations of TF by predicting randomly masked tokens. By utilizing MTP, TSSN is able to extract the high-level intrinsic semantics of TF, and provide general-purpose token embeddings, leading to improved overall performance and enhanced ability to adapt to different tasks. By substituting the last fully-connected layers with a group of untrained new layers and fine-tuning using small-scale task-specific data, TSSN can be utilized for a variety of downstream tasks in vehicular applications. Simulation results indicate that the TSSN enhances overall performance in comparison to state-of-the-art models.},
  preview = {TrafficFlow-TMC.jpg},
  description={A task-agnostic approach for understanding complex traffic flow using masked token enabled pre-training, enhancing feature representation and performance in vehicular applications.},
}

@inproceedings{geng2022feais,
  title={FEAIS: Facial emotion recognition enabled education aids IoT system for online learning},
  author={Geng, Yunxin and Meng, Han and Dou, Junyi},
  booktitle={2022 International Conference on Advanced Learning Technologies (ICALT)},
  pages={403--407},
  year={2022},
  organization={IEEE},
  doi={10.1109/ICALT55010.2022.00125},
  abstract={With the rapid development of big data analytics and the Internet of Things (IoT) technology, online learning becomes more and more prevalent. To improve the quality of online learning and help teachers better understand the students’ learning state, this paper proposes a Facial Emotion Recognition (FER) Enabled Education Aids IoT System, named FEAIS. By deploying a well-trained FER model on the remote server, FEAIS can provide instant feedback on students’ learning state by collecting their facial pictures through IoT devices like cameras or vision sensors and making recognization on their emotion. Utilizing this information, teachers can adjust their teaching progress to ensure that everyone could catch up. The experimental results demonstrate that the FEAIS can accurately recognize students’ emotion and give teachers precise feedback automatically, even if the images captured by IoT devices are occluded or deformed.},
  preview = {FEAIS-ICALT.jpg},
  description={A facial emotion recognition enabled education aids IoT system for online learning, enhancing the quality of online learning and the efficiency of teaching.},
}

@inproceedings{geng2026voi,
  title={VoI-Driven Traffic Patch Transmission: A Synergistic Framework for Efficient SCC},
  author={Geng, Yunxin and Luo, Yufan and Liu, Wenlong and Han, Lingyi},
  booktitle={2026 IEEE Wireless Communications and Networking Conference Workshops (WCNCW)},
  pages={1--6},
  year={2026},
  organization={IEEE},
  doi={10.1109/WCNCW67598.2026.11555545},
  abstract={The evolution of the sixth-generation (6G) Internet of Vehicles (IoV) necessitates a paradigm shift from raw data transmission to semantic communication. This paper proposes a distributed VoI-Driven Traffic Patch Transmission framework (VTPT) where roadside units (RSUs) and vehicles transmit Traffic Patches-time-sliced semantic blocks-to edge servers based on the value of information (VoI). By leveraging a SpatialTemporal Patch-based Self-Supervised Network (ST-PSSN), we implement a cloud-edge-end architecture. The experimental results show that the proposed framework can efficiently transmit the most valuable traffic information under resource-constrained conditions, thereby achieving more precise traffic control.},
  preview = {VTPT-WCNCW.jpg},
  description={A distributed VoI-Driven Traffic Patch Transmission framework for efficient SCC, enhancing the efficiency of traffic control in vehicular applications.},
}

@INPROCEEDINGS{long2026symbol,
  author={Long, Yuhan and Niu, Yangyang and Geng, Yunxin and Liu, Shang and Wei, Zhiqing},
  booktitle={2026 IEEE Wireless Communications and Networking Conference Workshops (WCNCW)},
  title={Symbol-wise Methods to Improve Sensing Performance of Single Carrier Waveform},
  year={2026},
  pages={1-6},
  keywords={Equations;Tagging;Timing;Optimization;Optimization methods;Symbols;OFDM;Distance measurement;Integrated sensing and communication;Printing;uplink ISAC;PA distortion;EISL;TPV;trade-off;CP-SC;waveform optimization},
  doi={10.1109/WCNCW67598.2026.11555151},
  abstract={Nonlinear power amplifier (PA) distortion and sensing performance are two critical concerns when using communication waveform for uplink sensing. In the first part of the paper, we prove that there is no communication signal base e.g., orthogonal frequency division multiplexing (OFDM) and single carrier (SC) that excels at both PA efficiency and sensing performance by solving a Pareto optimization problem using two relevant metrics i.e., integrated ranging sidelobe (EISL) and temporal power variance (TPV). In the second part, we seek to improve the sensing performance of SC. Specifically, we propose some symbol-wise methods to optimize the sidelobe of 2 dimensional periodic autocorrelation functions (2d P-ACF) of CP-SC (cyclic prefixd singlecarrier) in one coherent processing interval (CPI) while restricting the loss of communication performance. Simulation results are shown to validate our algorithms.},
  preview = {symbol-WCNCW.jpg},
  description={This paper investigates the inherent trade-off between power-amplifier efficiency measured by temporal power variance and sensing performance represented by expected integrated ranging sidelobe for uplink ISAC orthogonal communication bases, and proposes both convex symbol-wise optimization schemes and a low-complexity iterative clip-filter algorithm to enhance the 2D periodic autocorrelation-function sidelobe performance of CP-SC waveforms under constrained communication EVM loss.},
}

@INPROCEEDINGS{11641961,
  author={Chen, Guang and Zhou, Ying and Geng, Yunxin and Liu, Haotian and Wei, Zhiqing},
  booktitle={2026 6th International Conference on Computer Communication and Artificial Intelligence (CCAI)},
  title={Adaptive Resource Management for Multi-AGV Integrated Sensing, Communication, and Control Systems},
  year={2026},
  volume={},
  number={},
  pages={558-563},
  keywords={Resource management;Production;Equations;Optimization;Printing;Loading;Algorithms;Information rates;Throughput;Assembly;Two-stage Adaptive Resource Management (TARM);reinforcement learning;integrated sensing communication and control},
  doi={10.1109/CCAI69603.2026.11641961},
  abstract={To address the challenges of intense resource competition among communication, sensing, and control in industrial wireless networks, where communication congestion in largescale intelligent clusters thus limits production throughput, this paper proposes a Two-stage Adaptive Resource Management (TARM) method for integrated sensing, communication, and control (ISCC) systems. In the first stage, focusing on automated guided vehicle (AGV) material transportation within automotive assembly workshops, a safety-guided multi-agent reinforcement learning (MARL) adaptive closed-loop interaction cycle method is proposed. The base station (BS) proactively harvests sensing data to dynamically reconstruct AGV kinematic states. By dynamically modulating the closed-loop interaction cycles of multiple AGVs, the system shifts from traditional fixed-period communication to an active on-demand paradigm, this transition significantly reduces the underlying communication load, thereby effectively elevating the upper bound of the controllable AGV cluster capacity. In the second stage, leveraging the expanded upper bound of the controllable cluster scale from the first stage, this paper derives a cooperative scheduling algorithm for multiple AGVs. By incorporating AGV kinematic characteristics and cluster expansion capabilities with production efficiency, the algorithm dynamically adjusts task allocation logic to achieve a precise matching between logistical supply efficiency and multi-line demands, thereby enhancing workshop throughput. Simulation results demonstrate that TARM substantially outperforms the traditional algorithm with nmax outage tolerance (TANOT), classic ISAC algorithm (CISACA), and traditional algorithm (TA) benchmarks, achieving a 56% reduction in global communication load and a throughput enhancement of at least 30.73%.},
  description={This paper proposes a Two-stage Adaptive Resource Management (TARM) method for integrated sensing, communication, and control (ISCC) systems in industrial wireless networks, enhancing AGV cluster capacity and production throughput through dynamic closed-loop interaction cycles and cooperative scheduling algorithms.},
  preview={ISCC-CCAI.jpg}
  }

}
@INPROCEEDINGS{liu2026beyond,
  author={Liu, Haotian and Wei, Zhiqing and Li, Xingwang and Geng, Yunxin and Zhang, Qixun and Feng, Zhiyong},
  booktitle={2026 IEEE/CIC International Conference on Communications in China (ICCC)}, 
  title={Beyond Single-Band: Analysis and Resource Allocation for Multi-Band ISAC Systems}, 
  year={2026},
  volume={},
  number={},
  pages={926-931},
  keywords={Bars;Equations;Signal detection;Tagging;Integrated sensing and communication;Optimization;Probability;Frequency;Joints;Printing;Integrated sensing and communication (ISAC);multi-band ISAC;performance analysis;resource allocation;target detection},
  doi={10.1109/ICCC70295.2026.11680374},
  abstract={Integrated sensing and communication (ISAC) has emerged as a pivotal technology for sixth-generation wireless networks to empower high-precision sensing. The demand for superior sensing resolution and the reality of spectrum fragmentation have driven the research of multi-band ISAC. Multi-band ISAC provides frequency diversity through independent observations across disparate bands, mitigating sensing performance fluctuations caused by frequency-selective radar cross-section compared to single-band counterparts. In this paper, we propose a framework for analytical performance characterization and resource optimization in multi-band ISAC systems. Specifically, analytical closed-form detection and false alarm probabilities for multi-band OFDM signals are derived, providing a theoretical foundation for subsequent resource allocation. Then, a joint power and time-frequency resource allocation scheme is developed and solved via a proposed ADMM-based algorithm to maximize detection performance. Numerical results validate the accuracy of the closed-form derivations and demonstrate the superior robustness of multi-band signals. Notably, the proposed optimization scheme achieves an 18 dB detection gain over traditional single-band baselines at a 90\% detection probability.},
  description={This paper derives closed-form detection and false-alarm probabilities for multi-band ISAC OFDM signals using the generalized likelihood ratio test and proposes an ADMM-driven joint power and time-frequency resource allocation scheme to maximize target-detection performance, with simulations verifying theoretical accuracy and demonstrating prominent detection gains and enhanced robustness over single-band counterparts.},
  preview = {MultiBand-ICCC.jpg},
  }

@ARTICLE{liu2026dmsnet,
  author={Liu, Haotian and Wei, Zhiqing and Zhao, Quanjiang and Wang, Lin and Geng, Yunxin and Li, Xingwang and Feng, Zhiyong},
  journal={IEEE Wireless Communications Letters},
  title={DMSNet: Cross-Band Learning for Multi-Target Sensing in Dual-Band ISAC},
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Dual-band integrated sensing and communication (ISAC) offers complementary high- and low-frequency echo information for multi-target sensing. However, existing dual-band ISAC sensing methods have a limited ability to exploit deep complementary information across heterogeneous bands and often incur high computational costs. To address these limitations, we propose a Dual-Band Multi-Target Sensing Neural Network (DMSNet) for joint target number and parameter estimation. Under representative simulation conditions, DMSNet outperforms the best baseline in target number estimation, increasing count accuracy from 89.01% to 91.74% and Macro-F1 from 90.80% to 93.07%. For parameter estimation, compared with the best baselines, DMSNet reduces the median absolute errors of range, velocity, and angle by 82.2%, 56.9%, and 73.2%, respectively. Moreover, DMSNet reduces runtime by 68.7% relative to the fastest existing dual-band ISAC sensing method.},
  keywords={Dual band;Integrated sensing and communication;Parameter estimation;Modules (abstract algebra);Distance measurement;Estimation;Frequency;Head;Signal to noise ratio;Symbols;Integrated sensing and communication (ISAC);dual-band sensing;multi-target sensing;high- and low-frequency cooperation;deep learning},
  doi={10.1109/LWC.2026.3732429},
  ISSN={2162-2345},
  description={This paper proposes DMSNet, a coarse-to-fine dual-band multi-target sensing neural network that adaptively fuses cross-band complementary features to jointly estimate target count as well as range, velocity and angle, achieving substantial accuracy improvements and reduced inference runtime compared with existing multi-band ISAC sensing baselines.},
  preview = {DMSNet-WCL.jpg},
  month={},}